# Keep sources and generated bundles byte-stable across platforms.
# The build compares committed bundles and rendered references byte-for-byte
# (after newline normalization); LF-normalized checkouts keep working-tree
# diffs and file sizes stable on Windows as well.
* text=auto
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
